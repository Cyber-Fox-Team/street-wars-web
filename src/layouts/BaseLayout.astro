---
import '../styles/globals.css';

const { title = 'Los Santos Street Wars' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Los Santos Street Wars" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Permanent+Marker&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="cursor-default h-screen scrollbar-thin selection:bg-black selection:text-white">
    <slot />
  </body>
</html>
